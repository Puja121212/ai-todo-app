# ------------------------------------------------------------------------
# Root .gitignore for AI_TODO App (Secure for GitHub)
# ------------------------------------------------------------------------

# Dependency directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (Saves database credentials & API keys)
.env
.env.local
.env.production
.env.development
*.env
backend/.env
backend/.env.production
backend/.env.development
backend/.env.local
frontend/.env
frontend/.env.production
frontend/.env.development
frontend/.env.local

# Build/Production outputs
dist/
frontend/dist/
build/
backend/build/

# Logs and Debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System / OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
